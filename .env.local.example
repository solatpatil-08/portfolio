# Server-only OpenAI API credentials for pages/api/chat.ts.
# Copy this file to .env.local and replace the placeholder locally.
# Never commit .env.local or expose this value in client-side code.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the default Responses API model.
OPENAI_MODEL=gpt-4.1-mini
